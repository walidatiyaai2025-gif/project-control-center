{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Task",
  "type": "object",
  "required": ["TASK_ID", "PROJECT_ID", "STATE", "CANONICAL_BRANCH"],
  "properties": {
    "TASK_ID": {"type": "string"},
    "PROJECT_ID": {"type": "string"},
    "REQUIREMENT_ID": {"type": ["string", "null"]},
    "FEATURE_IDS": {"type": "array", "items": {"type": "string"}},
    "SCREENS_AFFECTED": {"type": "array", "items": {"type": "string"}},
    "ACTIONS_AFFECTED": {"type": "array", "items": {"type": "string"}},
    "TASK_TYPE": {"enum": ["STANDARD", "EMERGENCY_MITIGATION", "PERMANENT_INCIDENT_FIX"]},
    "INCIDENT_ID": {"type": ["string", "null"]},
    "TEMPORARY_FIX": {"type": "boolean"},
    "MUST_CARRY_FORWARD": {"type": "boolean"},
    "STATE": {"enum": ["AVAILABLE", "READY", "CLAIMED", "IN_PROGRESS", "BLOCKED", "STALE", "RECLAIMABLE", "READY_FOR_REVIEW", "READY_FOR_QA", "QA_PASS", "INTEGRATED", "RELEASED", "DONE"]},
    "CANONICAL_BRANCH": {"type": "string"},
    "LATEST_PUSHED_SHA": {"type": ["string", "null"]},
    "WORKER_LEASE": {"type": ["string", "null"]},
    "TARGET_VERSION": {"type": ["string", "null"]},
    "RELEASED_IN_VERSION": {"type": ["string", "null"]},
    "FEATURE_DELIVERY_EVIDENCE": {"type": "array"}
  }
}
